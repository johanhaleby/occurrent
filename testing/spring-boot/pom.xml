<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>testing</artifactId>
        <groupId>org.occurrent</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>occurrent-testing-spring-boot</artifactId>

    <name>${mavenProjectName}</name>

    <dependencies>
        <!--
          Both neutral leaves are optional. Adding one, or both, as a test dependency is how an application opts a
          stack into @EnableOccurrentTesting; OccurrentTestingImportSelector checks the classpath at import time to
          decide which configuration, or both, to register. A blocking-only application never pulls in reactor-core
          this way, and a reactive-only one never pulls in the blocking subscription API.
        -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-testing-junit-jupiter-blocking</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-subscription-api-blocking</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-testing-junit-jupiter-reactor</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-subscription-api-reactor</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <!--
          Optional the same way: EnableOccurrentTesting#clearState() only wires OccurrentMongoFlushTestingConfiguration
          when both occurrent-testing-mongodb and MongoTemplate are on the classpath, so a non-Mongo application never
          pulls either in.
        -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-testing-mongodb</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-mongodb</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-subscription-inmemory</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-eventstore-inmemory</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-subscription-synchronous-reactor</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mongodb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
