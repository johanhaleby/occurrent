<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>broker-kafka</artifactId>
        <groupId>org.occurrent</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>occurrent-broker-kafka-blocking</artifactId>

    <name>${mavenProjectName}</name>

    <dependencies>
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-broker-api-blocking</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-cloudevent-type-mapper-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- CloudEventConverter appears directly in this module's own public API (KafkaDomainEventSink.using(...)),
             so it's declared rather than left to arrive transitively through occurrent-broker-api-blocking. -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-cloudevent-converter-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- SubscriptionFilter (and its AgnosticSubscriptionFilter/StreamSubscriptionFilter wrappers) appears
             directly in this module's own public API (DestinationResolver#destinationsFor), so it's declared
             rather than left to arrive transitively through occurrent-broker-api-blocking. -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-subscription-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- EventMetadata appears directly in this module's own public API (KafkaDomainEventSink#publish) and the
             resolver reads the streamid extension off a CloudEvent for keying, so it's declared rather than left
             to arrive transitively through occurrent-broker-api-blocking. -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-cloudevents-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-retry</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>
        <!-- The CloudEvents Kafka binary binding writer, so this module writes the same ce_-prefixed headers a
             consumer built on cloudevents-kafka expects, instead of inventing its own mapping the way the
             RabbitMQ module has to (there is no CloudEvents binding for AMQP 0-9-1). -->
        <dependency>
            <groupId>io.cloudevents</groupId>
            <artifactId>cloudevents-kafka</artifactId>
        </dependency>
        <!-- CloudEvent appears directly in this module's own public API (CloudEventSink, DestinationResolver), so
             it's declared rather than left to arrive transitively. -->
        <dependency>
            <groupId>io.cloudevents</groupId>
            <artifactId>cloudevents-api</artifactId>
        </dependency>
        <!-- KafkaDomainEventSink#publish(EventMetadata, E) builds a fresh CloudEvent to stamp the supplied
             metadata onto, which needs the SDK's builder implementation rather than only its interfaces. -->
        <dependency>
            <groupId>io.cloudevents</groupId>
            <artifactId>cloudevents-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-cloudevent-type-mapper-reflection</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
