<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>broker-rabbitmq</artifactId>
        <groupId>org.occurrent</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>occurrent-broker-rabbitmq-blocking</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-broker-api-blocking</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-cloudevent-type-mapper-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- CloudEventConverter appears directly in this module's own public API (RabbitMqDomainEventSink.using(...)),
             so it's declared rather than left to arrive transitively through occurrent-broker-api-blocking. -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-cloudevent-converter-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- SubscriptionFilter (and its AgnosticSubscriptionFilter/StreamSubscriptionFilter wrappers) appears
             directly in this module's own public API (DestinationResolver#destinationsFor), so it's declared
             rather than left to arrive transitively through occurrent-broker-api-blocking. -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-subscription-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- EventMetadata appears directly in this module's own public API (RabbitMqDomainEventSink#publish), so
             it's declared rather than left to arrive transitively through occurrent-broker-api-blocking. -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-cloudevents-extension</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-retry</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- RabbitMqCloudEventBridge holds a PushSubscriptionModel and reads the RoutingOutcome its PushObserver
             reports, per ADR 133 decision 1. -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-subscription-push-blocking</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- RabbitMqDomainEventBridge holds a DomainEventFeed and calls its acceptCloudEvent(...), per ADR 133
             decision 5. -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-projection-dsl-blocking</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.rabbitmq</groupId>
            <artifactId>amqp-client</artifactId>
        </dependency>
        <!-- The bridges log a delivery failure action and a failed topology reconciliation. Declared directly
             rather than relied on as a transitive of occurrent-subscription-push-blocking. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- CloudEvent appears directly in this module's own public API (CloudEventSink, DestinationResolver), so
             it's declared rather than left to arrive transitively. -->
        <dependency>
            <groupId>io.cloudevents</groupId>
            <artifactId>cloudevents-api</artifactId>
        </dependency>
        <!-- RabbitMqDomainEventSink#publish(EventMetadata, E) builds a fresh CloudEvent to stamp the supplied
             metadata onto, which needs the SDK's builder implementation rather than only its interfaces. -->
        <dependency>
            <groupId>io.cloudevents</groupId>
            <artifactId>cloudevents-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <!-- The walk that once lived here moved into EventTypeNarrowing's own module, so nothing in this
             module's main code touches Filter or Condition any more. RabbitMqTopicExchangeDestinationResolverTest
             still builds Filter/Condition instances directly to exercise that resolver's destinationsFor, so this
             stays a test-scope dependency rather than being dropped. -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-filter</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-cloudevent-type-mapper-reflection</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The bridge tests wait on asynchronous consumer delivery and the coarse lifecycle poll. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A trivial PositionOrderedReader for the domain bridge tests' DomainEventFeed, which never actually
             replays in these tests (they only feed acceptCloudEvent(...)), so an in-memory store is enough. -->
        <dependency>
            <groupId>org.occurrent</groupId>
            <artifactId>occurrent-eventstore-inmemory</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
